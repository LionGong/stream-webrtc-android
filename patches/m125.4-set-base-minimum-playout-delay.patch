diff --git a/pc/audio_rtp_receiver.cc b/pc/audio_rtp_receiver.cc
index ae879ddb1b..60d0dabf8b 100644
--- a/pc/audio_rtp_receiver.cc
+++ b/pc/audio_rtp_receiver.cc
@@ -313,6 +313,54 @@ void AudioRtpReceiver::SetObserver(RtpReceiverObserverInterface* observer) {
   }
 }
 
+bool AudioRtpReceiver::SetBaseMinimumPlayoutDelayMs(int delay_ms) {
+  if (!worker_thread_->IsCurrent()) {
+    return worker_thread_->BlockingCall([this, delay_ms] {
+      return SetBaseMinimumPlayoutDelayMs(delay_ms);
+    });
+  }
+  RTC_DCHECK_RUN_ON(worker_thread_);
+  // NetEq rejects values outside 0..10000. Do not clamp into a different
+  // delay and report success, and do not call SetMinimumDelay.
+  if (delay_ms < 0 || delay_ms > 10000) {
+    return false;
+  }
+  absl::optional<uint32_t> ssrc = signaled_ssrc_;
+  if (media_channel_ && !ssrc.has_value()) {
+    ssrc = media_channel_->GetUnsignaledSsrc();
+  }
+  if (!media_channel_ || !ssrc.has_value()) {
+    // Cache so RestartMediaChannel_w applies this floor when the stream
+    // appears. The call has not reached a receive stream, so return false.
+    delay_.Set(static_cast<double>(delay_ms) / 1000.0);
+    return false;
+  }
+  const bool applied =
+      media_channel_->SetBaseMinimumPlayoutDelayMs(*ssrc, delay_ms);
+  if (applied) {
+    delay_.Set(static_cast<double>(delay_ms) / 1000.0);
+  }
+  return applied;
+}
+
+int AudioRtpReceiver::GetBaseMinimumPlayoutDelayMs() {
+  if (!worker_thread_->IsCurrent()) {
+    return worker_thread_->BlockingCall(
+        [this] { return GetBaseMinimumPlayoutDelayMs(); });
+  }
+  RTC_DCHECK_RUN_ON(worker_thread_);
+  absl::optional<uint32_t> ssrc = signaled_ssrc_;
+  if (media_channel_ && !ssrc.has_value()) {
+    ssrc = media_channel_->GetUnsignaledSsrc();
+  }
+  if (!media_channel_ || !ssrc.has_value()) {
+    return -1;
+  }
+  absl::optional<int> delay_ms =
+      media_channel_->GetBaseMinimumPlayoutDelayMs(*ssrc);
+  return delay_ms.value_or(-1);
+}
